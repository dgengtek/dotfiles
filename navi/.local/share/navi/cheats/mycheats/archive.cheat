% archive

# package to 7z with maximum compression
7z a -t7z -m0=lzma -mx=9 -mfb=64 -md=32m -ms=on

# extract archives to its folder
nu -c "ls | each {|x| let filename = (($x.name | parse --regex '(?<file>.+)\.(?<extension>\w+)') | get 0); mkdir $'($filename.file)'; 7z x $'-o($filename.file)' -y $'($x.name)' }"
